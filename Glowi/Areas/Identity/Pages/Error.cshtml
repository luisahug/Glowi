@page
@model ErrorModel
@{
    ViewData["Title"] = "Erro";
}

<div class="text-center py-5">
    <div class="display-3 fw-bold text-gradient mb-2"><i class="bi bi-exclamation-triangle"></i></div>
    <p class="lead text-muted mb-2">Ocorreu um erro ao processar sua solicitação.</p>
    <p class="text-muted mb-4">Tente novamente em alguns instantes.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Código do erro: <code>@Model.RequestId</code></p>
    }

    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house"></i> Voltar ao início</a>
</div>
