        </section>
    </div> *@
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const tipo = document.getElementById('Input_Tipo');
        const camposProfissional = document.getElementById('camposProfissional');

        function atualizarCampos() {
            camposProfissional.style.display = tipo.value === 'Profissional' ? '' : 'none';
        }

        tipo.addEventListener('change', atualizarCampos);
        atualizarCampos();
    </script>
}
