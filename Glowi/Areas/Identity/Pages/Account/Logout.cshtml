@page
@model LogoutModel
@{
    ViewData["Title"] = "Sair";
}

<div class="card auth-card">
    <div class="card-body text-center">
        <img src="~/icons/icon-192.png" alt="Glowi" class="auth-logo mb-3" />
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <h1 class="h3 mb-1">Sair da conta?</h1>
            <p class="text-muted mb-4">Você precisará entrar de novo para ver seus agendamentos.</p>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="w-100 btn btn-lg btn-glow">Sair</button>
            </form>
        }
        else
        {
            <h1 class="h3 mb-1">Até logo!</h1>
            <p class="text-muted mb-4">Você saiu da sua conta.</p>
            <a class="w-100 btn btn-lg btn-glow" asp-area="Identity" asp-page="/Account/Login">Entrar novamente</a>
        }
    </div>
</div>
