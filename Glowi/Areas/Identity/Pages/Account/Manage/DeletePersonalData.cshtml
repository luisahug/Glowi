@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Excluir conta";
    ViewData["ActivePage"] = ManageNavPages.DeletePersonalData;
}

<a asp-page="./PersonalData" class="link-back"><i class="bi bi-arrow-left"></i> Voltar</a>

<h2 class="h4 mb-3">Excluir conta</h2>

<div class="alert alert-danger d-flex gap-2" role="alert">
    <i class="bi bi-exclamation-triangle-fill"></i>
    <div>A exclusão é permanente: todos os seus dados serão apagados e não poderão ser recuperados.</div>
</div>

<form id="delete-user" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Input.Senha" class="form-control" autocomplete="current-password" placeholder="Senha" />
        <label asp-for="Input.Senha">Confirme sua senha</label>
        <span asp-validation-for="Input.Senha" class="text-danger"></span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-danger" type="submit">Excluir minha conta</button>
        <a asp-page="./PersonalData" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
