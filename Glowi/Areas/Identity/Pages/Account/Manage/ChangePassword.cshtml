@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Senha";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h2 class="h4 mb-1">Senha</h2>
<p class="text-muted mb-4">Use pelo menos 6 caracteres, com letra maiúscula, minúscula, número e símbolo.</p>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

    <div class="form-floating mb-3">
        <input asp-for="Input.SenhaAtual" class="form-control" autocomplete="current-password" placeholder="Senha atual" />
        <label asp-for="Input.SenhaAtual"></label>
        <span asp-validation-for="Input.SenhaAtual" class="text-danger"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.NovaSenha" class="form-control" autocomplete="new-password" placeholder="Nova senha" />
        <label asp-for="Input.NovaSenha"></label>
        <span asp-validation-for="Input.NovaSenha" class="text-danger"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.ConfirmarSenha" class="form-control" autocomplete="new-password" placeholder="Confirmar nova senha" />
        <label asp-for="Input.ConfirmarSenha"></label>
        <span asp-validation-for="Input.ConfirmarSenha" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Alterar senha</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
