@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dados pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2 class="h4 mb-1">Dados pessoais</h2>
<p class="text-muted mb-4">
    Você pode baixar uma cópia dos dados da sua conta ou excluí-la.
    A exclusão é permanente e não pode ser desfeita.
</p>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="d-flex flex-wrap gap-2">
    <form id="download-data" asp-page="DownloadPersonalData" method="post">
        <button class="btn btn-outline-primary" type="submit"><i class="bi bi-download"></i> Baixar meus dados</button>
    </form>
    <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Excluir conta</a>
</div>
