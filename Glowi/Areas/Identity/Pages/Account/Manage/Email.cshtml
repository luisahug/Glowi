@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h2 class="h4 mb-1">Email</h2>
<p class="text-muted mb-4">É o email que você usa para entrar no Glowi.</p>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

    <div class="form-floating mb-3">
        <input value="@Model.Email" class="form-control" id="email-atual" placeholder="Email atual" disabled />
        <label for="email-atual">Email atual</label>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.NovoEmail" class="form-control" autocomplete="email" placeholder="nome@exemplo.com" />
        <label asp-for="Input.NovoEmail"></label>
        <span asp-validation-for="Input.NovoEmail" class="text-danger"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.Senha" class="form-control" autocomplete="current-password" placeholder="senha" />
        <label asp-for="Input.Senha"></label>
        <span asp-validation-for="Input.Senha" class="text-danger"></span>
    </div>

    <button id="change-email-button" type="submit" class="btn btn-primary">Alterar email</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
