@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1>Minha conta</h1>
    <p>Gerencie seu perfil, email, senha e dados pessoais.</p>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-lg-9">
        <div class="card">
            <div class="card-body p-4">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
