@page
@model LoginModel

@{
    ViewData["Title"] = "Entrar";
}

<div class="card auth-card">
    <div class="card-body">
        <div class="text-center mb-4">
            <img src="~/icons/icon-192.png" alt="Glowi" class="auth-logo mb-3" />
            <h1 class="h3 mb-1">Que bom te ver!</h1>
            <p class="text-muted mb-0">Entre para gerenciar seus agendamentos.</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                <label asp-for="Input.Email" class="form-label">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="senha" />
                <label asp-for="Input.Password" class="form-label">Senha</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check mb-0">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Lembrar de mim</label>
                </div>
                <a id="forgot-password" class="small fw-semibold" asp-page="./ForgotPassword">Esqueceu a senha?</a>
            </div>
            <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-glow">Entrar</button>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="text-center text-muted small my-3">ou entre com</div>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name" title="Entrar com @provider.DisplayName">@provider.DisplayName</button>
                }
            </form>
        }

        <p class="text-center text-muted mt-4 mb-0">
            Ainda não tem conta?
            <a class="fw-semibold" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Cadastre-se</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
