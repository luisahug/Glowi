@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Esqueceu a senha?";
}

<div class="card auth-card">
    <div class="card-body">
        <div class="text-center mb-4">
            <span class="icon-box mb-3"><i class="bi bi-key"></i></span>
            <h1 class="h3 mb-1">Esqueceu a senha?</h1>
        </div>

        <p class="text-muted">
            A recuperação automática de senha por email ainda não está disponível no Glowi.
        </p>
        <p class="text-muted">
            Para recuperar o acesso, entre em contato com a equipe do Glowi informando o email da sua conta.
        </p>
        <p class="text-muted mb-4">
            Se você lembra da senha e só quer trocá-la, entre na sua conta e acesse <strong>Minha conta → Senha</strong>.
        </p>

        <a asp-page="./Login" class="w-100 btn btn-lg btn-glow">Voltar para o login</a>
    </div>
</div>
