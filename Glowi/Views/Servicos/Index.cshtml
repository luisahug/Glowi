@model IEnumerable<Glowi.Models.Servico>
@{
    ViewData["Title"] = "Meus serviços";
}

<div class="page-header">
    <h1>Meus serviços</h1>
    <p>Toque em um serviço para editar ou adicione imagens para os(as) clientes verem seu trabalho.</p>
</div>

<partial name="_Alertas" />

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">

    <div class="col">
        <button type="button" class="card card-add h-100 w-100 p-0 text-center"
                data-bs-toggle="modal" data-bs-target="#modalServico" data-modo="novo">
            <div class="card-body d-flex flex-column justify-content-center align-items-center w-100">
                <i class="bi bi-plus-circle fs-2 mb-1"></i>
                <span>Novo serviço</span>
            </div>
        </button>
    </div>

    @foreach (var s in Model)
    {
        <div class="col">
            <div class="card h-100">
                <button type="button" class="card-body card-acao text-start"
                        data-bs-toggle="modal" data-bs-target="#modalServico"
                        data-modo="editar"
                        data-id="@s.ServicoId"
                        data-nome="@s.Nome"
                        data-tecnicas="@System.Text.Json.JsonSerializer.Serialize(s.Tecnicas)"
                        data-duracao="@s.DuracaoMinutos"
                        data-preco="@s.Preco.ToString("0.00")">
                    <h5 class="card-title">@s.Nome</h5>
                    @if (s.Tecnicas.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var t in s.Tecnicas)
                            {
                                <span class="badge badge-soft-secondary">@t</span>
                            }
                        </div>
                    }
                    <p class="card-text text-muted mb-1"><i class="bi bi-clock me-1"></i>@s.DuracaoMinutos min</p>
                    <p class="card-text price mb-0">@s.Preco.ToString("C")</p>
                </button>
                <div class="card-footer bg-transparent">
                    <a class="btn btn-sm btn-outline-primary w-100" asp-action="Imagens" asp-route-id="@s.ServicoId">
                        <i class="bi bi-images me-1"></i>@(s.Imagens.Any() ? $"Imagens ({s.Imagens.Count})" : "Add imagens")
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="modalServico" tabindex="-1" aria-labelledby="modalServicoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="formServico" method="post" asp-controller="Servicos" asp-action="Create">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalServicoTitulo">Novo serviço</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="ServicoId" id="campoId" />

                    <div class="form-floating mb-3">
                        <input name="Nome" id="campoNome" class="form-control" placeholder="Nome" required maxlength="100" />
                        <label for="campoNome">Nome do serviço</label>
                    </div>

                    <div class="mb-3">
                        <div class="input-group">
                            <div class="form-floating">
                                <input id="campoTecnica" class="form-control" placeholder="Técnica"
                                       maxlength="@Glowi.Models.Servico.TecnicaMaximo" list="sugestoesTecnica" autocomplete="off"
                                       aria-describedby="ajudaTecnica" />
                                <label for="campoTecnica">Técnicas (opcional)</label>
                            </div>
                            <button type="button" class="btn btn-outline-primary" id="btnAddTecnica" aria-label="Adicionar técnica">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="form-text" id="ajudaTecnica">
                            Digite e toque em <strong>+</strong> (ou Enter) para adicionar. Ex.: gel, fibra de vidro, fio a fio. Até @Glowi.Models.Servico.TecnicasMaximo técnicas.
                        </div>
                        <div class="small text-danger mt-1 d-none" id="avisoTecnica" role="status" aria-live="polite"></div>
                        <div class="d-flex flex-wrap gap-1 mt-2" id="listaTecnicas" aria-label="Técnicas adicionadas"></div>
                        <datalist id="sugestoesTecnica">
                            @foreach (var t in Model.SelectMany(x => x.Tecnicas).Distinct(StringComparer.OrdinalIgnoreCase).Order())
                            {
                                <option value="@t"></option>
                            }
                        </datalist>
                    </div>

                    <div class="form-floating mb-3">
                        <input name="DuracaoMinutos" id="campoDuracao" type="number" class="form-control"
                               placeholder="60" required min="5" max="480" step="5" />
                        <label for="campoDuracao">Duração (minutos)</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input name="Preco" id="campoPreco" class="form-control" placeholder="49,90"
                               inputmode="decimal" required pattern="^\d+(,\d{1,2})?$"
                               title="Use vírgula para os centavos. Ex.: 49,90" />
                        <label for="campoPreco">Preço (R$)</label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btnExcluir" class="btn btn-outline-danger me-auto d-none">Excluir</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form id="formExcluir" method="post" class="d-none"></form>

@section Scripts {
    <script>
        const modal = document.getElementById('modalServico');
        const form = document.getElementById('formServico');
        const titulo = document.getElementById('modalServicoTitulo');
        const campoId = document.getElementById('campoId');
        const campoNome = document.getElementById('campoNome');
        const campoTecnica = document.getElementById('campoTecnica');
        const btnAddTecnica = document.getElementById('btnAddTecnica');
        const avisoTecnica = document.getElementById('avisoTecnica');
        const listaTecnicas = document.getElementById('listaTecnicas');
        const maximoTecnicas = @Glowi.Models.Servico.TecnicasMaximo;
        let tecnicas = [];

        const avisar = (texto) => {
            avisoTecnica.textContent = texto ?? '';
            avisoTecnica.classList.toggle('d-none', !texto);
        };

        const desenharTecnicas = () => {
            listaTecnicas.replaceChildren(...tecnicas.map((tecnica, i) => {
                const chip = document.createElement('span');
                chip.className = 'badge badge-soft-primary d-inline-flex align-items-center gap-1 py-2 ps-2 pe-1';
                chip.append(tecnica);

                const oculto = document.createElement('input');
                oculto.type = 'hidden';
                oculto.name = 'Tecnicas';
                oculto.value = tecnica;

                const remover = document.createElement('button');
                remover.type = 'button';
                remover.className = 'btn-close';
                remover.style.fontSize = '.55rem';
                remover.setAttribute('aria-label', 'Remover ' + tecnica);
                remover.addEventListener('click', () => {
                    tecnicas.splice(i, 1);
                    avisar();
                    desenharTecnicas();
                    campoTecnica.focus();
                });

                chip.append(oculto, remover);
                return chip;
            }));
            const cheio = tecnicas.length >= maximoTecnicas;
            campoTecnica.disabled = cheio;
            btnAddTecnica.disabled = cheio;
        };

        const adicionarTecnica = () => {
            const tecnica = campoTecnica.value.trim().replace(/\s+/g, ' ');
            if (!tecnica) return;
            if (tecnicas.some(t => t.toLocaleLowerCase() === tecnica.toLocaleLowerCase())) {
                avisar('Essa técnica já foi adicionada.');
                return;
            }
            if (tecnicas.length >= maximoTecnicas) {
                avisar(`Máximo de ${maximoTecnicas} técnicas por serviço.`);
                return;
            }
            tecnicas.push(tecnica);
            campoTecnica.value = '';
            avisar();
            desenharTecnicas();
            campoTecnica.focus();
        };

        btnAddTecnica.addEventListener('click', adicionarTecnica);
        campoTecnica.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                adicionarTecnica();
            }
        });

        form.addEventListener('submit', adicionarTecnica);
        const campoDuracao = document.getElementById('campoDuracao');
        const campoPreco = document.getElementById('campoPreco');
        const btnExcluir = document.getElementById('btnExcluir');
        const formExcluir = document.getElementById('formExcluir');

        modal.addEventListener('show.bs.modal', (evento) => {
            const card = evento.relatedTarget;
            const editar = card.dataset.modo === 'editar';

            titulo.textContent = editar ? 'Editar serviço' : 'Novo serviço';
            form.action = editar
                ? '@Url.Action("Edit", "Servicos")/' + card.dataset.id
                : '@Url.Action("Create", "Servicos")';

            campoId.disabled = !editar;
            campoId.value = editar ? card.dataset.id : '';

            campoNome.value = editar ? card.dataset.nome : '';
            campoTecnica.value = '';
            tecnicas = editar ? JSON.parse(card.dataset.tecnicas || '[]') : [];
            avisar();
            desenharTecnicas();
            campoDuracao.value = editar ? card.dataset.duracao : '';
            campoPreco.value = editar ? card.dataset.preco : '';

            btnExcluir.classList.toggle('d-none', !editar);
            btnExcluir.dataset.id = editar ? card.dataset.id : '';
        });

        btnExcluir.addEventListener('click', () => {
            if (confirm('Excluir este serviço? As imagens dele também serão apagadas.')) {
                formExcluir.action = '@Url.Action("Delete", "Servicos")/' + btnExcluir.dataset.id;
                formExcluir.submit();
            }
        });
    </script>
}
