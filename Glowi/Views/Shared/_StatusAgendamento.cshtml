@model Glowi.Models.Agendamento
@using Glowi.Models.Enum
@{
    var (texto, cor) = Model.Status switch
    {
        StatusAgendamento.Pendente => ("Pendente", "badge-soft-warning"),
        StatusAgendamento.Confirmado => ("Confirmado", "badge-soft-success"),
        StatusAgendamento.Cancelado => ("Cancelado", "badge-soft-secondary"),
        StatusAgendamento.Recusado => ("Recusado", "badge-soft-danger"),
        _ => (Model.Status.ToString(), "badge-soft-secondary")
    };
}

<span class="badge @cor">@texto</span>
@if (Model.Status != StatusAgendamento.Cancelado && Model.Status != StatusAgendamento.Recusado)
{
    <span class="small text-muted ms-1">
        <i class="bi @(Model.Concluido ? "bi-check-circle-fill text-success" : "bi-circle")"></i>
        @(Model.Concluido ? "Concluído" : "Não concluído")
    </span>
}
