@{
    var codigo = (int)ViewData["Codigo"]!;
    ViewData["Title"] = codigo == 404 ? "Página não encontrada" : "Erro";
}

<div class="text-center py-5">
    <div class="display-3 fw-bold text-gradient mb-2">@codigo</div>
    <p class="lead text-muted mb-4">
        @(codigo == 404 ? "Não encontramos o que você procurou." :
          codigo == 403 ? "Você não tem permissão para acessar esta página." :
          "Algo deu errado.")
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house"></i> Voltar ao início</a>
</div>
