@model Glowi.Models.Profissional
@{
    ViewData["Title"] = Model.Usuario?.Nome;
}

<a asp-action="Index" class="d-inline-block mb-3">&larr; Voltar</a>

<div class="mb-4">
    <h1 class="h3 mb-1">@Model.Usuario?.Nome</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Especialidade))
    {
        <p class="text-muted mb-2">@Model.Especialidade</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Biografia))
    {
        <p>@Model.Biografia</p>
    }
</div>

<h2 class="h5 mb-3">Serviços</h2>

<div class="list-group">
    @foreach (var s in Model.Servicos)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <div>
                <div class="fw-semibold">@s.Nome</div>
                <div class="text-muted small">@s.DuracaoMinutos min</div>
            </div>
            <div class="text-end">
                <div class="fw-semibold mb-1">@s.Preco.ToString("C")</div>
                <button type="button" class="btn btn-sm btn-primary" disabled>Agendar</button>
            </div>
        </div>
    }
</div>