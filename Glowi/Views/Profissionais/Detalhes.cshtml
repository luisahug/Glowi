@model Glowi.Models.Profissional
@inject Glowi.Services.SupabaseStorageService Storage
@{
    ViewData["Title"] = Model.Usuario?.Nome;
    var nome = Model.Usuario?.Nome ?? "";
    var data = Context.Request.Query["data"].ToString();
    var favorita = ViewData["Favorita"] as bool?;
    var urlAtual = Context.Request.Path + Context.Request.QueryString;
}

<a asp-action="Index" class="link-back"><i class="bi bi-arrow-left"></i> Voltar</a>

<partial name="_Alertas" />

<div class="card bg-soft mb-4">
    <div class="card-body d-flex gap-3 align-items-center">
        <span class="avatar avatar-lg">@(nome.Length > 0 ? nome[..1] : "?")</span>
        <div class="flex-grow-1">
            <h1 class="h3 mb-1">@nome</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Especialidade))
            {
                <p class="text-muted mb-0">@Model.Especialidade</p>
            }
            @{
                var distanciaKm = ViewData["DistanciaKm"] as double?;
                var localTexto = string.Join(" · ", new[]
                {
                    distanciaKm is double km ? $"a {Glowi.Services.Distancia.Formatar(km)} de você" : null,
                    Model.BairroCidade
                }.Where(t => t != null));
            }
            @if (localTexto.Length > 0)
            {
                <p class="small mb-0 mt-1"><i class="bi bi-geo-alt me-1"></i>@localTexto</p>
            }
        </div>
        @* só para clientes: favoritar / desfavoritar *@
        @if (favorita != null)
        {
            <form method="post" asp-controller="Favoritos" asp-action="@(favorita.Value ? "Desfavoritar" : "Favoritar")"
                  asp-route-profissionalId="@Model.ProfissionalId" asp-route-returnUrl="@urlAtual">
                <button type="submit" class="btn btn-icon @(favorita.Value ? "btn-danger" : "btn-outline-danger")"
                        title="@(favorita.Value ? "Remover dos favoritos" : "Adicionar aos favoritos")"
                        aria-label="@(favorita.Value ? "Remover dos favoritos" : "Adicionar aos favoritos")"
                        aria-pressed="@(favorita.Value ? "true" : "false")">
                    <i class="bi @(favorita.Value ? "bi-heart-fill" : "bi-heart")"></i>
                </button>
            </form>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Biografia))
    {
        <div class="card-body pt-0">
            <p class="mb-0">@Model.Biografia</p>
        </div>
    }
</div>

<h2 class="section-title">Serviços</h2>

<div class="list-group">
    @foreach (var s in Model.Servicos)
    {
        var carrosselId = $"carrossel-{s.ServicoId}";
        var variasImagens = s.Imagens.Count > 1;

        <div class="list-group-item py-3">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <span class="icon-box icon-box-sm"><i class="bi bi-stars"></i></span>
                    <div>
                        <div class="fw-semibold">@s.Nome</div>
                        <div class="text-muted small"><i class="bi bi-clock me-1"></i>@s.DuracaoMinutos min</div>
                    </div>
                </div>
                <div class="text-end">
                    <div class="price mb-1">@s.Preco.ToString("C")</div>
                    @if (User.IsInRole("Cliente"))
                    {
                        <a class="btn btn-sm btn-primary" asp-controller="Agendamentos" asp-action="CriarNovoAgendamento" asp-route-servicoId="@s.ServicoId" asp-route-data="@(string.IsNullOrEmpty(data) ? null : data)">Agendar</a>
                    }
                </div>
            </div>

            @if (s.Imagens.Any())
            {
                <div id="@carrosselId" class="carousel slide servico-carrossel mt-3 @(s.Imagens.Any(i => i.Descricao != null) ? "com-legenda" : "")"
                     aria-label="Fotos de @s.Nome">
                    @if (variasImagens)
                    {
                        <div class="carousel-indicators">
                            @for (var i = 0; i < s.Imagens.Count; i++)
                            {
                                <button type="button" data-bs-target="#@carrosselId" data-bs-slide-to="@i"
                                        class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : null)"
                                        aria-label="Foto @(i + 1)"></button>
                            }
                        </div>
                    }

                    <div class="carousel-inner">
                        @{ var primeira = true; }
                        @foreach (var imagem in s.Imagens)
                        {
                            <div class="carousel-item @(primeira ? "active" : "")">
                                <img src="@Storage.UrlPublica(imagem.CaminhoBucket)" alt="@(imagem.Descricao ?? s.Nome)" />
                                @if (imagem.Descricao != null)
                                {
                                    <div class="carousel-caption">@imagem.Descricao</div>
                                }
                            </div>
                            primeira = false;
                        }
                    </div>

                    @if (variasImagens)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#@carrosselId" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#@carrosselId" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Próxima</span>
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>
