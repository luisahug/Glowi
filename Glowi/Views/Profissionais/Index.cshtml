@model IEnumerable<Glowi.Models.Profissional>
@{
    ViewData["Title"] = "Profissionais";
}

<div class="page-header">
    <h1>Profissionais</h1>
    <p>Escolha uma profissional para ver os serviços e agendar.</p>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <span class="icon-box"><i class="bi bi-person-heart"></i></span>
        <p>Nenhuma profissional disponível no momento.</p>
    </div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
    @foreach (var p in Model)
    {
        var nome = p.Usuario?.Nome ?? "";
        <div class="col">
            <a asp-action="Detalhes" asp-route-id="@p.ProfissionalId" class="card h-100 text-reset">
                <div class="card-body d-flex gap-3">
                    <span class="avatar avatar-lg">@(nome.Length > 0 ? nome[..1] : "?")</span>
                    <div class="flex-grow-1 min-w-0">
                        <h5 class="card-title mb-1">@nome</h5>
                        @if (!string.IsNullOrWhiteSpace(p.Especialidade))
                        {
                            <p class="card-text text-muted small mb-2">@p.Especialidade</p>
                        }
                        <div class="d-flex flex-wrap gap-2 align-items-center small">
                            <span class="badge badge-soft-primary">@p.Servicos.Count @(p.Servicos.Count == 1 ? "serviço" : "serviços")</span>
                            <span class="text-muted">a partir de <span class="price">@p.Servicos.Min(s => s.Preco).ToString("C")</span></span>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted align-self-center"></i>
                </div>
            </a>
        </div>
    }
</div>
