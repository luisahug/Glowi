@model Glowi.Models.ViewModels.Agendamento.ConfirmarAgendamentoViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Confirmar agendamento";
    var inv = CultureInfo.InvariantCulture;
    var s = Model.Servico;
    var fim = Model.Inicio.AddMinutes(s.DuracaoMinutos);
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h4 mb-4">Confirmar agendamento</h1>

        <div class="card mb-4">
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><span class="text-muted">Serviço:</span> <strong>@s.Nome</strong></li>
                <li class="list-group-item"><span class="text-muted">Profissional:</span> @s.Profissional?.Usuario?.Nome</li>
                <li class="list-group-item"><span class="text-muted">Data:</span> @Model.Inicio.ToString("dddd, dd 'de' MMMM")</li>
                <li class="list-group-item"><span class="text-muted">Horário:</span> @Model.Inicio.ToString("HH:mm") às @fim.ToString("HH:mm")</li>
                <li class="list-group-item"><span class="text-muted">Valor:</span> @s.Preco.ToString("C")</li>
            </ul>
        </div>

        <form method="post" asp-action="ConfirmarAgendamento">
            <input type="hidden" name="servicoId" value="@s.ServicoId" />
            <input type="hidden" name="inicio" value="@Model.Inicio.ToString("yyyy-MM-ddTHH:mm", inv)" />

            <button type="submit" class="btn btn-primary btn-lg w-100 mb-2">Confirmar</button>
            <a class="btn btn-link w-100"
               asp-action="CriarNovoAgendamento" asp-route-servicoId="@s.ServicoId"
               asp-route-data="@DateOnly.FromDateTime(Model.Inicio).ToString("yyyy-MM-dd", inv)">
                Escolher outro horário
            </a>
        </form>
    </div>
</div>