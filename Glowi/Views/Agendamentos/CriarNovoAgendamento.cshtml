@model Glowi.Models.ViewModels.Agendamento.AgendarViewModel
@using System.Globalization
@using Glowi.Services
@{
    ViewData["Title"] = "Agendar";
    var inv = CultureInfo.InvariantCulture;
    var s = Model.Servico;
    var diaAnterior = Model.Data.AddDays(-1);
    var proximoDia = Model.Data.AddDays(1);
}

<a asp-controller="Profissionais" asp-action="Detalhes" asp-route-id="@s.Profissional.ProfissionalId" class="link-back"><i class="bi bi-arrow-left"></i> Voltar</a>

<div class="card mb-4">
    <div class="card-body d-flex align-items-center gap-3">
        <span class="icon-box"><i class="bi bi-stars"></i></span>
        <div>
            <h1 class="h4 mb-1">@s.Nome</h1>
            <p class="text-muted mb-0">
                com @s.Profissional?.Usuario?.Nome · @s.DuracaoMinutos min · <span class="price">@s.Preco.ToString("C")</span>
            </p>
            @if (s.Profissional?.EnderecoCompleto is string endereco)
            {
                <p class="small mb-0 mt-1"><i class="bi bi-geo-alt me-1"></i>@endereco</p>
            }
        </div>
    </div>
</div>

@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-warning">@erro</div>
}

<form method="get" asp-action="CriarNovoAgendamento" class="d-flex flex-wrap align-items-end gap-2 mb-4">
    <input type="hidden" name="servicoId" value="@s.ServicoId" />

    <a class="btn btn-icon btn-outline-secondary @(diaAnterior < Model.Hoje ? "disabled" : "")"
       asp-action="CriarNovoAgendamento" asp-route-servicoId="@s.ServicoId"
       asp-route-data="@diaAnterior.ToString("yyyy-MM-dd", inv)" aria-label="Dia anterior"><i class="bi bi-chevron-left"></i></a>

    <div class="form-floating">
        <input type="date" name="data" id="campoData" class="form-control"
               value="@Model.Data.ToString("yyyy-MM-dd", inv)"
               min="@Model.Hoje.ToString("yyyy-MM-dd", inv)"
               max="@Model.Maximo.ToString("yyyy-MM-dd", inv)"
               onchange="this.form.submit()" />
        <label for="campoData">Data</label>
    </div>

    <a class="btn btn-icon btn-outline-secondary @(proximoDia > Model.Maximo ? "disabled" : "")"
       asp-action="CriarNovoAgendamento" asp-route-servicoId="@s.ServicoId"
       asp-route-data="@proximoDia.ToString("yyyy-MM-dd", inv)" aria-label="Próximo dia"><i class="bi bi-chevron-right"></i></a>
</form>

<h2 class="section-title">Horários livres em @Model.Data.ToString("dddd, dd/MM")</h2>

@if (!Model.Horarios.Any())
{
    <div class="empty-state">
        <span class="icon-box"><i class="bi bi-calendar-x"></i></span>
        <p>Nenhum horário livre nesse dia. Tente outra data.</p>
    </div>
}
else
{
    var temConflito = Model.Horarios.Any(h => Model.ConflitoCom(h) != null);

    if (temConflito)
    {
        <div class="alert alert-warning small d-flex gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                Os horários riscados coincidem com outro agendamento seu nesse dia:
                <ul class="mb-1">
                    @foreach (var a in Model.MeusAgendamentosNoDia)
                    {
                        <li>@a.Servico?.Nome com @a.Profissional?.Usuario?.Nome · @Horario.ParaBrasilia(a.Inicio).ToString("HH:mm") às @Horario.ParaBrasilia(a.Fim).ToString("HH:mm")</li>
                    }
                </ul>
                Para marcar nesses horários, cancele primeiro esse agendamento em <a asp-action="MeusAgendamentos" class="alert-link">Meus agendamentos</a>.
            </div>
        </div>
    }

    <div class="slot-grid">
        @foreach (var h in Model.Horarios)
        {
            var conflito = Model.ConflitoCom(h);

            if (conflito != null)
            {
                <span class="btn btn-outline-secondary disabled text-decoration-line-through"
                      title="Você já tem @conflito.Servico?.Nome com @conflito.Profissional?.Usuario?.Nome nesse horário"
                      aria-label="@h.ToString("HH:mm"): você já tem agendamento nesse horário">
                    @h.ToString("HH:mm")
                </span>
            }
            else
            {
                <a class="btn btn-outline-primary"
                   asp-action="RevisarAgendamento"
                   asp-route-servicoId="@s.ServicoId"
                   asp-route-inicio="@h.ToString("yyyy-MM-ddTHH:mm", inv)">
                    @h.ToString("HH:mm")
                </a>
            }
        }
    </div>
}
