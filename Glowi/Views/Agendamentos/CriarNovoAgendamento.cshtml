@model Glowi.Models.ViewModels.Agendamento.AgendarViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Agendar";
    var inv = CultureInfo.InvariantCulture;
    var s = Model.Servico;
    var diaAnterior = Model.Data.AddDays(-1);
    var proximoDia = Model.Data.AddDays(1);
}

<a asp-controller="Profissionais" asp-action="Detalhes" asp-route-id="@s.Profissional.ProfissionalId" class="d-inline-block mb-3">&larr; Voltar</a>

<div class="card mb-4">
    <div class="card-body">
        <h1 class="h4 mb-1">@s.Nome</h1>
        <p class="text-muted mb-0">
            com @s.Profissional?.Usuario?.Nome · @s.DuracaoMinutos min · @s.Preco.ToString("C")
        </p>
    </div>
</div>

@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-warning">@erro</div>
}

<form method="get" asp-action="CriarNovoAgendamento" class="d-flex flex-wrap align-items-end gap-2 mb-4">
    <input type="hidden" name="servicoId" value="@s.ServicoId" />

    <a class="btn btn-outline-secondary @(diaAnterior < Model.Hoje ? "disabled" : "")"
       asp-action="CriarNovoAgendamento" asp-route-servicoId="@s.ServicoId"
       asp-route-data="@diaAnterior.ToString("yyyy-MM-dd", inv)" aria-label="Dia anterior">&larr;</a>

    <div class="form-floating">
        <input type="date" name="data" id="campoData" class="form-control"
               value="@Model.Data.ToString("yyyy-MM-dd", inv)"
               min="@Model.Hoje.ToString("yyyy-MM-dd", inv)"
               max="@Model.Maximo.ToString("yyyy-MM-dd", inv)"
               onchange="this.form.submit()" />
        <label for="campoData">Data</label>
    </div>

    <a class="btn btn-outline-secondary @(proximoDia > Model.Maximo ? "disabled" : "")"
       asp-action="CriarNovoAgendamento" asp-route-servicoId="@s.ServicoId"
       asp-route-data="@proximoDia.ToString("yyyy-MM-dd", inv)" aria-label="Próximo dia">&rarr;</a>
</form>

<h2 class="h5 mb-3">Horários livres em @Model.Data.ToString("dddd, dd/MM")</h2>

@if (!Model.Horarios.Any())
{
    <div class="alert alert-light border">Nenhum horário livre nesse dia. Tente outra data.</div>
}
else
{
    <div class="d-flex flex-wrap gap-2">
        @foreach (var h in Model.Horarios)
        {
            <a class="btn btn-outline-primary"
               asp-action="RevisarAgendamento"
               asp-route-servicoId="@s.ServicoId"
               asp-route-inicio="@h.ToString("yyyy-MM-ddTHH:mm", inv)">
                @h.ToString("HH:mm")
            </a>
        }
    </div>
}