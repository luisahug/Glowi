@model Glowi.Models.ViewModels.Agendamento.MeusAgendamentosViewModel
@using Glowi.Services
@{
    ViewData["Title"] = "Meus agendamentos";

    var secoes = new[]
    {
        (Titulo: "Próximos", Itens: Model.Proximos),
        (Titulo: "Histórico", Itens: Model.Historico)
    };
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1>Meus agendamentos</h1>
        <p>Acompanhe seus horários marcados.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Profissionais" asp-action="Index"><i class="bi bi-plus-lg"></i> Novo agendamento</a>
</div>

<partial name="_Alertas" />

@if (!Model.Proximos.Any())
{
    <div class="empty-state mb-4">
        <span class="icon-box"><i class="bi bi-calendar-heart"></i></span>
        <p>Você não tem agendamentos marcados.</p>
        <a class="btn btn-sm btn-outline-primary mt-3" asp-controller="Profissionais" asp-action="Index">Ver profissionais</a>
    </div>
}

@foreach (var secao in secoes.Where(s => s.Itens.Any()))
{
    <h2 class="section-title">@secao.Titulo</h2>

    <div class="list-group mb-4">
        @foreach (var a in secao.Itens)
        {
            var inicio = Horario.ParaBrasilia(a.Inicio);
            var fim = Horario.ParaBrasilia(a.Fim);

            <div class="list-group-item py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <div class="fw-semibold">@a.Servico?.Nome · <span class="price">@a.Servico?.Preco.ToString("C")</span></div>
                        <div><i class="bi bi-calendar3 text-muted me-1"></i>@inicio.ToString("dddd, dd/MM 'às' HH:mm") – @fim.ToString("HH:mm")</div>
                        <div class="text-muted small">
                            com @a.Profissional?.Usuario?.Nome
                            @if (!string.IsNullOrWhiteSpace(a.Profissional?.Telefone))
                            {
                                <text>· @a.Profissional.Telefone</text>
                            }
                        </div>
                        <div class="mt-2"><partial name="_StatusAgendamento" model="a" /></div>
                    </div>

                    @if (a.EmAberto)
                    {
                        <form method="post" asp-action="Cancelar" asp-route-id="@a.AgendamentoId"
                              onsubmit="return confirm('Cancelar este agendamento?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
