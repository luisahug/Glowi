@model Glowi.Models.ViewModels.Agendamento.MeusAgendamentosViewModel
@using Glowi.Services
@{
    ViewData["Title"] = "Meus agendamentos";

    var secoes = new[]
    {
        (Titulo: "Próximos", Itens: Model.Proximos),
        (Titulo: "Histórico", Itens: Model.Historico)
    };

    var modalCancelar = new Glowi.Models.ViewModels.ModalConfirmacaoViewModel
    {
        Id = "modalCancelar",
        Titulo = "Cancelar agendamento?",
        Texto = "O horário será liberado para outros(as) clientes. Essa ação não pode ser desfeita.",
        Icone = "bi-calendar-x",
        Manter = "Manter",
        Confirmar = "Sim, cancelar"
    };
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1>Meus agendamentos</h1>
        <p>Acompanhe seus horários marcados.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Profissionais" asp-action="Index"><i class="bi bi-plus-lg"></i> Novo agendamento</a>
</div>

<partial name="_Alertas" />

@if (Model.AvisosCancelamento.Any())
{
    var varios = Model.AvisosCancelamento.Count > 1;

    <div class="alert alert-warning alert-dismissible fade show d-flex gap-2" role="alert">
        <i class="bi bi-calendar-x-fill"></i>
        <div>
            <div class="fw-semibold">
                @(varios ? "Alguns agendamentos foram cancelados pelo(a) profissional" : "Um agendamento foi cancelado pelo(a) profissional")
            </div>
            <div class="small mb-1">O(a) profissional não vai atender @(varios ? "nesses horários" : "nesse horário"). Você pode agendar outro horário quando quiser.</div>
            <ul class="mb-0 small">
                @foreach (var a in Model.AvisosCancelamento)
                {
                    <li>
                        @a.Servico?.Nome com @a.Profissional?.Usuario?.Nome ·
                        @Horario.ParaBrasilia(a.Inicio).ToString("dddd, dd/MM 'às' HH:mm")
                    </li>
                }
            </ul>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

@if (!Model.Proximos.Any())
{
    <div class="empty-state mb-4">
        <span class="icon-box"><i class="bi bi-calendar-heart"></i></span>
        <p>Você não tem agendamentos marcados.</p>
        <a class="btn btn-sm btn-outline-primary mt-3" asp-controller="Profissionais" asp-action="Index">Ver profissionais</a>
    </div>
}

@foreach (var secao in secoes.Where(s => s.Itens.Any()))
{
    <h2 class="section-title">@secao.Titulo</h2>

    <div class="list-group mb-4">
        @foreach (var a in secao.Itens)
        {
            var inicio = Horario.ParaBrasilia(a.Inicio);
            var fim = Horario.ParaBrasilia(a.Fim);

            <div class="list-group-item py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <div class="fw-semibold">@a.Servico?.Nome · <span class="price">@a.Preco.ToString("C")</span></div>
                        <div><i class="bi bi-calendar3 text-muted me-1"></i>@inicio.ToString("dddd, dd/MM 'às' HH:mm") – @fim.ToString("HH:mm")</div>
                        <div class="text-muted small">
                            com @a.Profissional?.Usuario?.Nome
                            @if (!string.IsNullOrWhiteSpace(a.Profissional?.Telefone))
                            {
                                <text>· @a.Profissional.Telefone</text>
                            }
                        </div>
                        @if (a.Profissional?.EnderecoCompleto is string endereco)
                        {
                            <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@endereco</div>
                        }
                        <div class="mt-2"><partial name="_StatusAgendamento" model="a" /></div>
                    </div>

                    @if (a.EmAberto)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#modalCancelar"
                                data-acao="@Url.Action("Cancelar", new { id = a.AgendamentoId })"
                                data-resumo="@a.Servico?.Nome"
                                data-quando="@inicio.ToString("dddd, dd/MM 'às' HH:mm")"
                                data-pessoa="com @a.Profissional?.Usuario?.Nome">
                            Cancelar
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

<partial name="_ModalConfirmacao" model="modalCancelar" />
