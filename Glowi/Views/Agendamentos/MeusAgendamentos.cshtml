@model Glowi.Models.ViewModels.Agendamento.MeusAgendamentosViewModel
@using Glowi.Services
@{
    ViewData["Title"] = "Meus agendamentos";

    var secoes = new[]
    {
        (Titulo: "Próximos", Itens: Model.Proximos),
        (Titulo: "Histórico", Itens: Model.Historico)
    };
}

<h1 class="h3 mb-4">Meus agendamentos</h1>

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @sucesso
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @erro
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

@if (!Model.Proximos.Any())
{
    <div class="alert alert-light border mb-4">
        Você não tem agendamentos marcados.
        <a asp-controller="Profissionais" asp-action="Index">Ver profissionais</a>
    </div>
}

@foreach (var secao in secoes.Where(s => s.Itens.Any()))
{
    <h2 class="h5 mb-3">@secao.Titulo</h2>

    <div class="list-group mb-4">
        @foreach (var a in secao.Itens)
        {
            var inicio = Horario.ParaBrasilia(a.Inicio);
            var fim = Horario.ParaBrasilia(a.Fim);

            <div class="list-group-item py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <div class="fw-semibold">@a.Servico?.Nome · @a.Servico?.Preco.ToString("C")</div>
                        <div>@inicio.ToString("dddd, dd/MM 'às' HH:mm") – @fim.ToString("HH:mm")</div>
                        <div class="text-muted small">
                            com @a.Profissional?.Usuario?.Nome
                            @if (!string.IsNullOrWhiteSpace(a.Profissional?.Telefone))
                            {
                                <text>· @a.Profissional.Telefone</text>
                            }
                        </div>
                        <div class="mt-1"><partial name="_StatusAgendamento" model="a" /></div>
                    </div>

                    @if (a.EmAberto)
                    {
                        <form method="post" asp-action="Cancelar" asp-route-id="@a.AgendamentoId"
                              onsubmit="return confirm('Cancelar este agendamento?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
