@model List<Glowi.Models.Profissional>
@{
    ViewData["Title"] = "Profissionais favoritos(as)";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1>Profissionais favoritos(as)</h1>
        <p>Seus(suas) profissionais preferidos(as), à mão para agendar de novo.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Profissionais" asp-action="Index"><i class="bi bi-search-heart"></i> Encontrar profissionais</a>
</div>

<partial name="_Alertas" />

@if (!Model.Any())
{
    <div class="empty-state">
        <span class="icon-box icon-box-pink"><i class="bi bi-heart"></i></span>
        <p>Você ainda não tem favoritos(as). Toque no <i class="bi bi-heart"></i> no perfil de um(a) profissional para guardá-lo(a) aqui.</p>
        <a class="btn btn-sm btn-outline-primary mt-3" asp-controller="Profissionais" asp-action="Index">Ver profissionais</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
        @foreach (var p in Model)
        {
            var nome = p.Usuario?.Nome ?? "";
            var servicos = p.Servicos.Take(3).ToList();
            var restantes = p.Servicos.Count - servicos.Count;
            <div class="col">
                <div class="card h-100">
                    <div class="card-body d-flex gap-3">
                        <span class="avatar avatar-lg">@(nome.Length > 0 ? nome[..1] : "?")</span>
                        <div class="flex-grow-1 min-w-0">
                            <h5 class="card-title mb-1">@nome</h5>
                            @if (!string.IsNullOrWhiteSpace(p.Especialidade))
                            {
                                <p class="card-text text-muted small mb-2">@p.Especialidade</p>
                            }
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @foreach (var s in servicos)
                                {
                                    <span class="badge badge-soft-secondary">@s.Nome</span>
                                }
                                @if (restantes > 0)
                                {
                                    <span class="badge badge-soft-secondary">+@restantes</span>
                                }
                            </div>
                            @if (p.Servicos.Any())
                            {
                                <div class="small text-muted">
                                    a partir de <span class="price">@p.Servicos.Min(s => s.Preco).ToString("C")</span>
                                </div>
                            }
                            else
                            {
                                <div class="small text-muted">Sem serviços no momento.</div>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center gap-2">
                        <form method="post" asp-action="Desfavoritar" asp-route-profissionalId="@p.ProfissionalId">
                            <button type="submit" class="btn btn-sm btn-link text-danger px-0" title="Remover dos favoritos">
                                <i class="bi bi-heart-fill me-1"></i>Remover
                            </button>
                        </form>
                        <a class="btn btn-sm btn-primary" asp-controller="Profissionais" asp-action="Detalhes" asp-route-id="@p.ProfissionalId">Ver serviços</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
